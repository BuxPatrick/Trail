{
  "name": "trail",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "dev:server": "npm run build:shared && npm run dev --workspace @trail/server",
    "dev:client": "npm run dev --workspace @trail/client",
    "migrate": "tsx server/src/migrate-cli.ts",
    "build": "npm run build:shared && npm run build --workspace @trail/client",
    "build:shared": "npm run build --workspace @trail/shared"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
